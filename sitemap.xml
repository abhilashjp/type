---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {%- for p in site.pages %}
  {%- if p.layout == 'page' or p.layout == 'writing' %}{% unless p.url == '/' or p.robots contains 'noindex' or p.url contains '404' %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.8</priority>
  </url>
  {%- endunless %}{% endif %}
  {%- endfor %}
  {%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.modified | default: post.date | date_to_xmlschema }}</lastmod>
    <priority>0.7</priority>
  </url>
  {%- endfor %}
</urlset>
